<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/settingPoint"
    android:background="?attr/colorPrimary"
    android:orientation="horizontal">

    <ImageView
        android:layout_marginTop="@dimen/distance_eight"
        android:layout_marginStart="@dimen/distance_thirteen"
        android:id="@+id/trackImage"
        android:layout_width="45dp"
        android:layout_height="45dp"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginStart="66dp"
        android:layout_marginEnd="44dp">

        <TextView
            android:id="@+id/trackName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/distance_fourteen"
            style="@style/settingTextPoint"
            android:paddingStart="0dp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Название трека" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/distance_thirteen">

            <TextView
                android:id="@+id/artistName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/trackWithNameAndTime"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/trackDot"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="Имя исполнителя"
                />

            <ImageView
                android:id="@+id/trackDot"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                style="@style/trackDot"
                android:src="@drawable/ic_dot_13"
                app:layout_constraintStart_toEndOf="@id/artistName"
                app:layout_constraintEnd_toStartOf="@+id/trackTimeMillis"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/trackTimeMillis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/trackWithNameAndTime"
                app:layout_constraintStart_toEndOf="@id/trackDot"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="1:00"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/button_right"
        style="@style/settingIcPoint"
        android:src="@drawable/ic_arrow_right_24"
        />


</FrameLayout>
