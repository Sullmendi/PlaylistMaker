<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/favorite_tracks"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    tools:context="com.practicum.playlistmarket2.keeping.ui.PlaylistFragment">
    <Button
        android:id="@+id/refresh_button"
        style="@style/refreshButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="91dp"
        android:minHeight="36dp"
        android:text="@string/create_new_playlist"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        />
    <ImageView
        android:id="@+id/empty_playlist_image"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:layout_marginTop="46dp"
        />
    <TextView
        android:id="@+id/empty_playlist_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/placeboText"
        tools:text="@string/empty_media_playlists"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/distance_sixteen"
        android:paddingHorizontal="24dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"/>
</LinearLayout>