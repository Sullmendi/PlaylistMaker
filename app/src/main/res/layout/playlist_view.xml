<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="196dp"
    android:background="?attr/colorPrimary"
    android:orientation="vertical">
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/playlist_image"
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:scaleType="centerCrop"
        />

    <TextView
        android:id="@+id/playlist_name"
        android:layout_width="match_parent"
        style="@style/PlaylistIconText"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Название плейлиста"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/playlist_image"/>

    <TextView
        android:id="@+id/count_tracks"
        android:layout_width="wrap_content"
        style="@style/PlaylistIconText"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="00 треков"
        app:layout_constraintTop_toBottomOf="@+id/playlist_name"
        app:layout_constraintStart_toStartOf="@+id/playlist_name"
        />
</androidx.constraintlayout.widget.ConstraintLayout>




</FrameLayout>