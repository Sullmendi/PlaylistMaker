<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/create_playlist_fragment"
    android:background="?attr/colorPrimary"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.practicum.playlistmarket2.mediateka.ui.playlist.CreatePlaylistFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_arrow"
            style="@style/buttonBack"
            app:icon="@drawable/ic_back_arrow_24"
            />

        <TextView
            android:layout_height="@dimen/distance_forty_eight"
            style="@style/startTextUpOnPage"
            android:layout_marginStart="@dimen/distance_twelve"
            android:text="@string/create_new_playlist" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout_editor_absoluteX="1dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/leftBorder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="@dimen/distance_sixteen" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/rightBorder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="@dimen/distance_sixteen" />

        <LinearLayout
            android:id="@+id/playlistImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="26dp"
            app:layout_constraintStart_toEndOf="@id/leftBorder"
            app:layout_constraintEnd_toStartOf="@id/rightBorder"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintDimensionRatio="h,1:1"
            android:layout_marginLeft="@dimen/distance_eight"
            android:layout_marginRight="@dimen/distance_eight"
            android:background="@drawable/playlist_image_shape"
            android:cropToPadding="true"
            android:clipToPadding="true"
            android:gravity="center"
            >

            <ImageView
                android:id="@+id/inside_playlist_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_add_photo_100"
                />
        </LinearLayout>

        <EditText
            android:id="@+id/edit_text_name"
            style="@style/EditTextPlaylist"
            android:layout_marginTop="32dp"
            android:hint="@string/playlist_name"
            app:layout_constraintEnd_toStartOf="@id/rightBorder"
            app:layout_constraintStart_toEndOf="@id/leftBorder"
            app:layout_constraintTop_toBottomOf="@id/playlistImage"
            android:layout_width="0dp"
            android:paddingStart="@dimen/distance_sixteen"
            android:inputType="text"
            android:lines="1"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:focusableInTouchMode="true"/>

        <EditText
            android:id="@+id/edit_text_description"
            style="@style/EditTextPlaylist"
            android:layout_marginTop="@dimen/distance_sixteen"
            android:hint="@string/playlist_description"
            app:layout_constraintStart_toEndOf="@id/leftBorder"
            app:layout_constraintEnd_toStartOf="@id/rightBorder"
            app:layout_constraintTop_toBottomOf="@id/edit_text_name"
            android:layout_width="0dp"
            android:paddingStart="@dimen/distance_sixteen"
            android:inputType="text"
            android:lines="1"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:focusableInTouchMode="true"/>

        <Button
            android:id="@+id/button_create"
            android:backgroundTint="@drawable/button_create_tap_enabled"
            app:cornerRadius="8dp"
            android:textColor="@color/white"
            android:fontFamily="@font/ys_display_medium"
            android:textAllCaps="false"
            android:textSize="@dimen/text_sixteen"
            android:layout_width="0dp"
            android:layout_height="44dp"
            app:layout_constraintStart_toEndOf="@id/leftBorder"
            app:layout_constraintEnd_toStartOf="@id/rightBorder"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="32dp"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="1dp"
            android:text="@string/create_playlist"
            android:letterSpacing="0"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
