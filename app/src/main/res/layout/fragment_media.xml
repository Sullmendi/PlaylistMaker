<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/media_fragment"
    android:background="?attr/colorPrimary"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.practicum.playlistmarket2.keeping.ui.MediaFragment"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            style="@style/startTextUpOnPage"
            android:layout_height="@dimen/distance_forty_eight"
            android:layout_marginStart="@dimen/distance_sixteen"
            android:text="@string/media" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        style="@style/TabLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/distance_forty_eight"
        android:background="?attr/colorPrimary"
        app:backgroundTint="?attr/colorPrimary"
        app:tabTextAppearance="@style/TabText"
        app:tabMode="fixed"/>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
</LinearLayout>