<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:id="@+id/choose_playlist"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey"
    tools:context="com.practicum.playlistmarket2.mediateka.ui.one_playlist.ChoosePlaylistFragment">

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/all_elements">

    <ImageView
        android:id="@+id/playlist_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="h,1:1"
        android:cropToPadding="true"
        android:clipToPadding="true"
        android:scaleType="centerCrop"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/button_arrow"
            style="@style/buttonBackPlaylist"
            app:icon="@drawable/ic_back_arrow_24"
            android:layout_marginStart="4dp"
            />
    </LinearLayout>

    <TextView
        android:id="@+id/playlist_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playlist_image"
        android:layout_marginTop="@dimen/distance_twenty_four"
        android:layout_marginStart="@dimen/distance_sixteen"
        android:fontFamily="@font/ys_display_bold"
        android:textSize="@dimen/text_twenty_four"
        tools:text="Best playlist"
        android:maxLines="1"
        android:ellipsize="end"
        />

    <TextView
        android:id="@+id/playlist_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/placeboText"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playlist_name"
        android:layout_marginTop="@dimen/distance_eight"
        android:layout_marginStart="@dimen/distance_sixteen"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="@dimen/text_eighteen"
        tools:text="Какое-то крутое описание"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/time_information"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playlist_description"
        android:layout_marginTop="@dimen/distance_eight"
        app:layout_goneMarginTop="37dp"
        android:layout_marginStart="@dimen/distance_sixteen"
        >

        <TextView
            android:id="@+id/playlist_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/placeboText"
            android:textColor="@color/black"
            android:textSize="@dimen/text_eighteen"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="1000 минут"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <ImageView
            android:id="@+id/trackDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_dot_13"
            app:layout_constraintStart_toEndOf="@id/playlist_time"
            app:layout_constraintEnd_toStartOf="@+id/track_count"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="@color/black" />

        <TextView
            android:id="@+id/track_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/placeboText"
            android:textColor="@color/black"
            android:textSize="@dimen/text_eighteen"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/trackDot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="48 треков"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/sharing_button"
        android:src="@drawable/ic_sharing_24"
        app:layout_constraintTop_toBottomOf="@+id/time_information"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/distance_sixteen"
        android:layout_marginStart="@dimen/distance_sixteen"
        app:tint="@color/black"
        />

    <ImageView
        android:id="@+id/setting_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_three_dots_24"
        app:layout_constraintTop_toBottomOf="@+id/time_information"
        app:layout_constraintStart_toEndOf="@+id/sharing_button"
        android:layout_marginTop="@dimen/distance_sixteen"
        android:layout_marginStart="@dimen/distance_sixteen"
        app:tint="@color/black"
        />

</androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/standard_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_sheet_shape"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:behavior_peekHeight="266dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            style="@style/ViewBottomSheet"
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/distance_eight" />

        <TextView
            android:id="@+id/no_tracks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/distance_twelve"
            style="@style/placeboText"
            android:text="@string/no_tracks"
            android:layout_gravity="center"
            android:visibility="gone"
            android:gravity="center"
            />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_tracks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/distance_twelve"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

    </LinearLayout>

    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/menu_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_sheet_shape"
        android:orientation="vertical"
        app:behavior_hideable="true"
        app:behavior_peekHeight="383dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            style="@style/ViewBottomSheet"
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/distance_eight" />

        <FrameLayout
            style="@style/settingPoint"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/distance_twelve">

            <ImageView
                android:layout_marginTop="@dimen/distance_eight"
                android:layout_marginStart="@dimen/distance_thirteen"
                android:id="@+id/playlist_image_bottom"
                android:layout_width="45dp"
                android:layout_height="45dp"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginStart="66dp"
                android:layout_marginEnd="44dp">

                <TextView
                    android:id="@+id/playlist_name_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/distance_fourteen"
                    style="@style/settingTextPoint"
                    android:paddingStart="0dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Название плейлиста" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/distance_thirteen">

                    <TextView
                        android:id="@+id/track_count_bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/trackWithNameAndTime"
                        android:maxLines="1"
                        android:ellipsize="end"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        tools:text="25 треков"
                        />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

        </FrameLayout>
        <FrameLayout
            android:layout_marginTop="@dimen/distance_eight"
            style="@style/settingPoint"
            android:id="@+id/share_playlist">

            <TextView
                style="@style/settingTextPoint"
                android:text="@string/share_bottom" />

        </FrameLayout>
        <FrameLayout
            style="@style/settingPoint"
            android:id="@+id/edit_playlist">

            <TextView
                style="@style/settingTextPoint"
                android:text="@string/edit_info_bottom" />

        </FrameLayout>
        <FrameLayout
            style="@style/settingPoint"
            android:id="@+id/delete_playlist">

            <TextView
                style="@style/settingTextPoint"
                android:text="@string/delete_playlist_bottom" />

        </FrameLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>