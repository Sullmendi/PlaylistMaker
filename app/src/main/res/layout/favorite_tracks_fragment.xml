<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/favorite_tracks"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    tools:context="com.practicum.playlistmarket2.keeping.ui.FavoriteTrackFragment">
<ImageView
    android:id="@+id/empty_favorite_image"
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:layout_gravity="center"
    android:layout_marginTop="106dp"
    />
    <TextView
        android:id="@+id/empty_favorite_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/placeboText"
        tools:text="@string/empty_media_tracks"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/distance_sixteen"/>
</LinearLayout>