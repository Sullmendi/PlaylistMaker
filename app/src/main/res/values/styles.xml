<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="mainButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="cornerRadius">@dimen/distance_sixteen</item>
        <item name="iconTint">@color/black</item>
        <item name="iconPadding">@dimen/distance_eight</item>
        <item name="iconGravity">textStart</item>
        <item name="android:textSize">@dimen/text_twenty_two</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="settingPoint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">61dp</item>
    </style>

    <style name="settingTextPoint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">start|center_vertical</item>
        <item name="android:paddingStart">@dimen/distance_sixteen</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/text_sixteen</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
    </style>

    <style name="settingIcPoint">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical|end</item>
        <item name="android:paddingEnd">@dimen/distance_twelve</item>
    </style>

    <style name="searchBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@drawable/shape_edit_text_light</item>
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="android:textColorHint">@color/shadow_grey</item>
        <item name="android:textSize">@dimen/text_sixteen</item>
        <item name="android:drawableTint">@color/shadow_grey</item>
        <item name="android:layout_margin">@dimen/distance_sixteen</item>
        <item name="android:drawablePadding">@dimen/distance_eight</item>
        <item name="cursorColor">@color/blue</item>
    </style>

    <style name="icon_clear">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_gravity">end|center_vertical</item>
        <item name="android:layout_marginEnd">@dimen/distance_sixteen</item>
        <item name="backgroundTint">@color/grey</item>
    </style>

    <style name="buttonBack" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">@dimen/distance_forty_eight</item>
        <item name="android:layout_height">@dimen/distance_forty_eight</item>
        <item name="iconTint">@color/black</item>
        <item name="android:paddingHorizontal">@dimen/distance_twelve</item>
    </style>

    <style name="startTextUpOnPage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/text_twenty_two</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="fontFamily">@font/ys_display_regular</item>
    </style>
    
    <style name="trackWithNameAndTime">
        <item name="android:textColor">@color/shadow_grey</item>
        <item name="android:textSize">@dimen/text_eleven</item>
        <item name="fontFamily">@font/ys_display_regular</item>
    </style>

    <style name="trackDot">
        <item name="backgroundTint">@color/shadow_grey</item>
        <item name="android:layout_gravity">end|center_vertical</item>
    </style>

    <style name="placeboText">
        <item name="android:textSize">19sp</item>
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="refreshButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:backgroundTint">@color/black</item>
        <item name="cornerRadius">54dp</item>
        <item name="android:textSize">@dimen/text_fourteen</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">@dimen/distance_fourteen</item>
        <item name="android:paddingRight">@dimen/distance_fourteen</item>
    </style>

    <style name="ButtonPlayTrack">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/light_white</item>
    </style>

    <style name="trackDescription">
        <item name="android:textColor">@color/shadow_grey</item>
        <item name="android:textSize">@dimen/text_thirteen</item>
        <item name="fontFamily">@font/ys_display_regular</item>
    </style>

    <style name="TabLayout" parent="TextAppearance.AppCompat.Body1">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/distance_forty_eight</item>
        <item name="tabIndicatorColor">@color/black</item>
        <item name="tabIndicator">@drawable/indicator_width</item>
        <item name="tabSelectedTextColor">@color/black</item>
    </style>

    <style name="TabText">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_fourteen</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
    </style>

</resources>